# ==============================================================================
# Agentic Workflow Engine - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the secrets for your target environment.
# Never commit real credentials or secret keys to version control.

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# In production, set FRONTEND_URL to your deployed frontend domain (e.g. https://my-app.vercel.app)
FRONTEND_URL=*

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (supports Neon, Supabase, Render, AWS RDS)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Maximum connections in the PostgreSQL client pool (recommended 5-10 for free tiers)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. MESSAGE QUEUE & CACHE (Redis / BullMQ)
# ------------------------------------------------------------------------------
# Redis connection string (Render, Upstash, Redis Cloud, or local Docker)
# Both REDIS_URL and Redis_URL are supported.
REDIS_URL="redis://default:password@hostname:6379"

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret string used to sign and verify JSON Web Tokens (JWT)
# Generate a strong 256-bit secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="YOUR_SECURE_JWT_SECRET_STRING"
JWT_EXPIRES_IN="4h"

# Master Encryption Key: Required for AES-256-GCM encryption of org API keys at rest.
# MUST be an exact 64-character hexadecimal string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="YOUR_EXACT_64_CHARACTER_HEXADECIMAL_ENCRYPTION_KEY"

# ------------------------------------------------------------------------------
# 5. AI ENGINE CREDENTIALS (Strictly Multi-Tenant)
# ------------------------------------------------------------------------------
# NOTE: No server-level GEMINI_API_KEY is needed or used in production!
# Each organization securely configures their own Gemini API key in the UI under
# Settings > Credentials. The backend encrypts keys at rest using ENCRYPTION_KEY.

# ------------------------------------------------------------------------------
# 6. WORKER & UNIFIED SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# By default, running 'npm start' executes BOTH the Fastify Web API and the
# BullMQ Background Worker in the SAME unified process (ideal for Render free tier).
# You do NOT need any RUN_WORKER flag.

# (Optional) Max jobs processed in parallel. Defaults to 3 in production to fit 512MB RAM.
WORKER_CONCURRENCY=3

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Organization {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  
  // These are the relations. An organization "owns" all of these records.
  users           User[]
  workflows       Workflow[]
  credentials     Credential[]
  idempotencyKeys IdempotencyKey[]

  executions      WorkflowExecution[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  createdAt      DateTime     @default(now())
  
  // Multi-tenant isolation link
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Credential {
  id             String       @id @default(uuid())
  name           String       
  encryptedData  String       
  createdAt      DateTime     @default(now())
  
  // Multi-tenant isolation link
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Workflow {
  id             String       @id @default(uuid())
  name           String
  description    String?
  status         String       @default("DRAFT")
  nodesJson      Json         
  dagJson        Json         
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Multi-tenant isolation link
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  executions      WorkflowExecution[]
}

model IdempotencyKey {
  id             String       @id
  responseBody   Json?        
  createdAt      DateTime     @default(now())
  
  // Multi-tenant isolation link
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Represents a single run of a workflow
model WorkflowExecution {
  id             String         @id @default(uuid())
  workflowId     String
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         String         @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  
  // Multi-tenant isolation link
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  logs           ExecutionLog[]
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
}


model ExecutionLog {
  id             String            @id @default(uuid())
  executionId    String
  execution      WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  
  nodeId         String            // The specific step in the workflow (e.g., "extract_data")
  status         String            // COMPLETED or FAILED
  outputData     Json?             // The result of this step (e.g., the LLM summary)
  
  createdAt      DateTime          @default(now())

  // Ensure a node is only logged once per execution to prevent duplicate inserts
  @@unique([executionId, nodeId]) 
}